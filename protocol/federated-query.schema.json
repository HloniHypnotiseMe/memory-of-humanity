{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://memory-of-humanity.org/protocol/federated-query.schema.json",
  "title": "Memory of Humanity Federated Query",
  "type": "object",
  "required": ["query_id", "query_type"],
  "properties": {
    "query_id": {"type": "string", "pattern": "^moh:query:"},
    "query_type": {"type": "string", "enum": ["text", "place_memory"]},
    "text": {"type": ["string", "null"]},
    "place_id": {"type": ["string", "null"], "pattern": "^moh:place:"},
    "time": {"type": ["object", "null"]},
    "record_types": {"type": "array", "items": {"type": "string"}},
    "relationship_types": {"type": "array", "items": {"type": "string"}},
    "limit": {"type": "integer", "minimum": 1, "maximum": 1000}
  },
  "additionalProperties": false
}