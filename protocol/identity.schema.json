{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Memory of Humanity Contributor Identity",
  "type": "object",
  "required": ["id", "kind", "display_name"],
  "properties": {
    "id": {"type": "string", "pattern": "^moh:(person|community|institution):[A-Za-z0-9._:-]+$"},
    "kind": {"type": "string", "enum": ["person", "community", "institution"]},
    "display_name": {"type": "string", "minLength": 1},
    "description": {"type": ["string", "null"]},
    "public_key": {"type": ["string", "null"]},
    "contact": {"type": ["string", "null"]},
    "created_at": {"type": ["string", "null"], "format": "date-time"}
  },
  "additionalProperties": false
}