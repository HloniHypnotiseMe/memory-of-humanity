{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://memory-of-humanity.org/protocol/graph-result.schema.json",
  "title":"Memory of Humanity Graph Result",
  "type":"object",
  "required":["nodes","edges","paths"],
  "properties":{
    "nodes":{"type":"array","items":{"type":"object","required":["id"],"properties":{"id":{"type":"string"},"record":{"type":"object"}},"additionalProperties":true}},
    "edges":{"type":"array","items":{"type":"object","required":["source","target","relationship_type"],"properties":{"source":{"type":"string"},"target":{"type":"string"},"relationship_type":{"type":"string"}},"additionalProperties":true}},
    "paths":{"type":"array","items":{"type":"object","required":["start","end","nodes","edges"],"properties":{"start":{"type":"string"},"end":{"type":"string"},"nodes":{"type":"array","items":{"type":"string"}},"edges":{"type":"array","items":{"type":"string"}}},"additionalProperties":true}}
  },
  "additionalProperties":false
}